# ==============================================================================
# mVerse Multi-Provider LLM Configuration (Speed-Optimized)
# Ranked from fastest direct response to secondary fallbacks.
# Only configured keys will be queried (missing keys are skipped with 0ms delay).
# ==============================================================================

# 1. Google Gemini (Fastest response with gemini-flash-lite-latest ~400-800ms)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 2. Groq Cloud (Ultra-fast LPU inference: ~250ms, 14,400 free requests/day)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. GitHub Models via Azure AI (Fast GPT-4o-mini ~800ms)
# Create a free GitHub token at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# 4. Cerebras Cloud (Fast LPU inference: ~400ms, 1M free tokens/day)
# Get your free key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# 5. OpenRouter (Backup fallback for free models like meta-llama/llama-3.3-70b-instruct:free)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Server Port
PORT=5001
